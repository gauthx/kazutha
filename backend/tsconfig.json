{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/types": [
        "../shared/types.d.ts"
      ],
      "@shared/*": [
        "../shared/*.d.ts"
      ]
    },
    "rootDir": "./src"
  },
  "include": [
    "src"
  ]
}